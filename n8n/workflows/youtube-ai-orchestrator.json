{
  "name": "YouTube AI Orchestrator - BrotaVida + DineroClaro",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 0 0,6,12,18 * * *"
            },
            {
              "field": "cronExpression",
              "expression": "0 0 8,13,17,21 * * *"
            }
          ]
        }
      },
      "id": "d7aebf44-4d12-4d74-a701-fae5fc18d4c5",
      "name": "Schedule",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [-480, -40]
    },
    {
      "parameters": {},
      "id": "4ecda2ac-438e-4f11-87a5-e09ce37938d2",
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [-480, 180]
    },
    {
      "parameters": {
        "jsCode": "const now = new Date();\nconst hour = Number(new Intl.DateTimeFormat('en-US', {\n  timeZone: 'America/Argentina/Buenos_Aires',\n  hour: '2-digit',\n  hour12: false,\n}).format(now));\n\nlet channel = 'brotavida';\nlet automatic = false;\n\nif ([0, 6, 12, 18].includes(hour)) {\n  channel = 'brotavida';\n  automatic = true;\n} else if ([8, 13, 17, 21].includes(hour)) {\n  channel = 'dineroclaro';\n  automatic = true;\n}\n\nif ($execution.mode === 'manual') {\n  automatic = true;\n  channel = 'brotavida';\n}\n\nif (!automatic) return [];\n\nreturn [{ json: {\n  channel,\n  dry_run: $execution.mode === 'manual',\n  requested_at: now.toISOString(),\n  request_id: `${channel}-${now.getTime()}`\n}}];"
      },
      "id": "7b22e696-992b-44c6-915e-f2943c67aff6",
      "name": "Select Channel",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-230, 70]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.github.com/repos/Demianvel/YouTube-AI-Automation/actions/workflows/shorts.yml/dispatches",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {"name": "Accept", "value": "application/vnd.github+json"},
            {"name": "X-GitHub-Api-Version", "value": "2026-03-10"}
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({ ref: 'main', inputs: { channel: $json.channel, dry_run: String($json.dry_run) } }) }}",
        "options": {}
      },
      "id": "aa6a8bc4-afbe-45c6-b602-e2497099c8ca",
      "name": "Dispatch GitHub Action",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [40, 70]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {"id": "26921737-c7df-46b0-9b20-381f1e309cbf", "name": "status", "value": "GitHub Action dispatched", "type": "string"},
            {"id": "48ddb1ee-cbe3-4cf2-b190-c39de2402e9e", "name": "channel", "value": "={{ $('Select Channel').item.json.channel }}", "type": "string"},
            {"id": "74f06891-1388-4493-8595-68386975fb29", "name": "dry_run", "value": "={{ $('Select Channel').item.json.dry_run }}", "type": "boolean"},
            {"id": "a80c4de2-7f07-413f-913d-2f49b424d992", "name": "requested_at", "value": "={{ $('Select Channel').item.json.requested_at }}", "type": "string"}
          ]
        },
        "options": {}
      },
      "id": "bba9f7d7-40e4-4a74-94c3-778e49f4a716",
      "name": "Result",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [300, 70]
    }
  ],
  "connections": {
    "Schedule": {"main": [[{"node": "Select Channel", "type": "main", "index": 0}]]},
    "Manual Trigger": {"main": [[{"node": "Select Channel", "type": "main", "index": 0}]]},
    "Select Channel": {"main": [[{"node": "Dispatch GitHub Action", "type": "main", "index": 0}]]},
    "Dispatch GitHub Action": {"main": [[{"node": "Result", "type": "main", "index": 0}]]}
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "timezone": "America/Argentina/Buenos_Aires"
  },
  "versionId": "d30c8230-4399-4550-b5fc-b55576bcb342",
  "meta": {"templateCredsSetupCompleted": false},
  "tags": []
}
